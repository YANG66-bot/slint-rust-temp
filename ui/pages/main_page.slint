// 主页：纯频谱层——直接撑满透明窗口，浮在桌面壁纸上。
//
// 仅保留粉青渐变频谱柱、顶部峰点、倒影与基线；
// 无任何文本、按钮或面板底色。
import { Spectrum, SpectrumBarData } from "../components/spectrum.slint";

export component MainPage inherits Rectangle {
    // 频谱数据模型（由 AppWindow 透传，Rust 端写入）
    in property <[SpectrumBarData]> bars: [];
    // 视觉开关（透传至 Spectrum）
    in property <bool> show-reflection: true;
    in property <bool> show-baseline: true;

    width: 100%;
    height: 100%;
    background: transparent;

    Spectrum {
        width: 100%;
        height: 100%;
        bars: root.bars;
        show-reflection: root.show-reflection;
        show-baseline: root.show-baseline;
    }

    // 全窗口拖动热区：按住任意位置拖动即可移动挂件（no-frame 窗口的
    // 移动能力由窗口系统执行）。纯频谱无其他交互元素，无事件冲突；
    // 声明在 Spectrum 之后 = 最上层，确保始终接收拖拽。
    // 未指定宽高时自动扩展至父元素几何，且不影响边缘缩放热区。
    WindowMoveArea { }
}
