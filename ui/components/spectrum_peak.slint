// 峰值指示：悬浮于柱顶上方的小亮点/短线。
//
// 跟随峰值位置（0..1）缓慢下落、快速上跳（动力学在 Rust 端
// PeakHold + 插值层完成，此处纯展示）。
import { Metrics } from "../theme/dimensions.slint";

export component SpectrumPeak inherits Rectangle {
    // 峰值归一化位置 0..1（相对频谱区域可用高度）
    in property <float> peak-height: 0;
    // 峰点颜色（Phase 5 传入柱色的亮化版本）
    in property <color> peak-color: #FFFFFF;
    // 槽位索引（与柱保持同一水平位置）
    in property <int> slot-index: 0;
    // 槽位宽度（由容器按总宽 / 柱数计算）
    in property <length> slot-width: 0px;
    // 底部对齐的基线 y
    in property <length> baseline-y: 0px;
    // 运行时柱宽占槽位比例（与主柱保持一致）
    in property <float> width-ratio: Metrics.bar-width-ratio;
    // 峰点与柱顶的间距（可由面板实时调节）
    in property <length> peak-gap: Metrics.peak-gap;

    x: self.slot-width * self.slot-index + (self.slot-width - self.width) / 2;
    width: self.slot-width * self.width-ratio;

    height: Metrics.peak-height;
    // 峰点悬浮于柱顶上方：基线 - 峰值高度 - 间隙 - 自身厚度
    y: max(0px, self.baseline-y - self.peak-height * self.baseline-y
        - self.peak-gap - self.height);

    border-radius: self.height / 2;
    background: self.peak-color;
    opacity: Metrics.peak-opacity;
}
